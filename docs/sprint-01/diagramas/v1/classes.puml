@startuml
!pragma layout smetana
title Sistema de Moeda Estudantil - Diagrama de Classes de Domínio - v1
top to bottom direction
hide circle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 55
skinparam ranksep 50
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

abstract class Usuario {
  - id: Long
  - nome: String
  - login: String
  - senhaHash: String
  - ativo: boolean
  --
  + autenticar(senha: String): boolean
}

class Aluno {
  - email: String
  - cpf: String
  - rg: String
  - endereco: String
  - curso: String
  --
  + consultarExtrato(): List<Transacao>
  + resgatar(vantagem: Vantagem): ResgateVantagem
}

class Professor {
  - cpf: String
  - departamento: String
  --
  + distribuirMoedas(aluno, quantidade, motivo): TransferenciaMoeda
  + consultarExtrato(): List<Transacao>
}

class EmpresaParceira {
  - email: String
  --
  + cadastrarVantagem(vantagem: Vantagem): void
}

class Conta {
  - id: Long
  - saldoMoedas: long
  --
  + creditar(quantidade: long): void
  + debitar(quantidade: long): void
  + possuiSaldo(quantidade: long): boolean
}

class InstituicaoEnsino {
  - id: Long
  - nome: String
}

class Vantagem {
  - id: Long
  - descricao: String
  - fotoReferencia: String
  - custoMoedas: long
}

abstract class Transacao {
  - id: Long
  - quantidadeMoedas: long
  - realizadaEm: Instant
}

class TransferenciaMoeda {
  - motivo: String
}

class CreditoSemestral {
  - semestreReferencia: String
}

class ResgateVantagem {
  - codigo: String
}

Usuario <|--down- Aluno
Usuario <|--down- Professor
Usuario <|--down- EmpresaParceira

Aluno "1" *-- "1" Conta : possui >
Professor "1" *-- "1" Conta : possui >

InstituicaoEnsino "1" -- "0..*" Aluno : reúne >
InstituicaoEnsino "1" -- "0..*" Professor : reúne >
EmpresaParceira "1" *-- "0..*" Vantagem : oferece >

Transacao <|--down- TransferenciaMoeda
Transacao <|--down- CreditoSemestral
Transacao <|--down- ResgateVantagem

Professor "1" -- "0..*" TransferenciaMoeda : envia >
Aluno "1" -- "0..*" TransferenciaMoeda : recebe >
Professor "1" -- "0..*" CreditoSemestral : recebe >
Aluno "1" -- "0..*" ResgateVantagem : realiza >
Vantagem "1" -- "0..*" ResgateVantagem : origina >

Aluno -[hidden]right- Professor
Professor -[hidden]right- EmpresaParceira
InstituicaoEnsino -[hidden]right- Conta
Conta -[hidden]right- Vantagem
TransferenciaMoeda -[hidden]right- CreditoSemestral
CreditoSemestral -[hidden]right- ResgateVantagem

@enduml
