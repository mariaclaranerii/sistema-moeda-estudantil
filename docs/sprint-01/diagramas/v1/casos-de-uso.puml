@startuml
title Sistema de Moeda Estudantil - Diagrama de Casos de Uso - v1
left to right direction

skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam nodesep 50
skinparam ranksep 55
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

package "Atores principais" {
  actor "Usuário\n(qualquer perfil)" as Usuario
  actor "Aluno" as Aluno
  actor "Professor" as Professor
  actor "Empresa parceira" as Empresa

  Usuario -[hidden]down- Aluno
  Aluno -[hidden]down- Professor
  Professor -[hidden]down- Empresa
}

rectangle "Sistema de Moeda Estudantil" {
  usecase "UC01\nAutenticar-se" as UC01

  package "Funções do aluno" {
    usecase "UC02\nGerenciar cadastro de aluno\n(cadastrar, consultar,\natualizar e desativar)" as UC02 <<acesso misto>>
    usecase "UC07\nConsultar extrato" as UC07 <<autenticado>>
    usecase "UC09\nConsultar vantagens" as UC09 <<autenticado>>
    usecase "UC10\nResgatar vantagem" as UC10 <<autenticado>>

    UC02 -[hidden]right- UC07
    UC07 -[hidden]right- UC09
    UC09 -[hidden]right- UC10
  }

  package "Funções do professor" {
    usecase "UC05\nTransferir moedas\na um aluno" as UC05 <<autenticado>>
    usecase "UC06\nConsultar extrato" as UC06 <<autenticado>>

    UC05 -[hidden]right- UC06
  }

  package "Funções da empresa parceira" {
    usecase "UC03\nGerenciar cadastro da empresa\n(cadastrar, consultar,\natualizar e desativar)" as UC03 <<acesso misto>>
    usecase "UC08\nCadastrar vantagem" as UC08 <<autenticado>>

    UC03 -[hidden]right- UC08
  }

  package "Processos automáticos" {
    usecase "UC04\nCreditar 1.000 moedas\npor semestre" as UC04
    usecase "UC11\nNotificar recebimento\nde moedas" as UC11
    usecase "UC12\nEnviar cupom ao aluno\ne à empresa" as UC12

    UC04 -[hidden]down- UC11
    UC11 -[hidden]down- UC12
  }

  UC01 -[hidden]down- UC02
  UC02 -[hidden]down- UC05
  UC05 -[hidden]down- UC03
  UC01 -[hidden]right- UC04
}

package "Serviços externos" {
  actor "Agendador\nsemestral" as Agendador
  actor "Serviço de e-mail" as Email

  Agendador -[hidden]down- Email
}

Usuario --> UC01

Aluno --> UC02
Aluno --> UC07
Aluno --> UC09
Aluno --> UC10

Professor --> UC05
Professor --> UC06

Empresa --> UC03
Empresa --> UC08

UC04 --> Agendador
UC11 --> Email
UC12 --> Email

UC05 .> UC11 : <<include>>
UC10 .> UC12 : <<include>>

legend bottom left
  Os casos marcados como autenticados exigem usuário ativo e sessão iniciada.
  Em acesso misto, o cadastro inicial é público; as demais operações exigem sessão.
  Instituições e professores são pré-cadastrados; o mecanismo administrativo
  não faz parte dos fluxos públicos do sistema.
endlegend
@enduml
