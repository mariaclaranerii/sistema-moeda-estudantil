@startuml
!pragma layout smetana
title Sistema de Moeda Estudantil - Diagrama de Componentes MVC - v1
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 55
skinparam ranksep 55
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Aluno / Professor /\nEmpresa parceira" as Usuario
component "Navegador web" as Browser

rectangle "Aplicação Java (Spring Boot)" {
  package "View" #E0F2FE {
    component "Templates\nThymeleaf" as ViewTemplates
  }

  package "Controller" #EDE9FE {
    component "Autenticação e\nautorização" as AuthModule
    component "Controladores MVC" as MvcControllers
  }

  package "Model" #DCFCE7 {
    component "Serviços de\naplicação" as AppService
    component "Modelo de domínio" as DomainModel
    component "Portas de\nrepositório" as RepoPorts
  }

  package "Infraestrutura" #FEF3C7 {
    component "Agendador\nsemestral" as Scheduler
    component "Adaptadores de\npersistência" as Persistence
    component "Adaptador\nde e-mail" as MailAdapter
  }

  ViewTemplates -[hidden]right- AuthModule
  AuthModule -[hidden]right- MvcControllers
  MvcControllers -[hidden]down- AppService
  AppService -[hidden]right- DomainModel
  DomainModel -[hidden]right- RepoPorts
  AppService -[hidden]down- Scheduler
  Scheduler -[hidden]right- Persistence
  Persistence -[hidden]right- MailAdapter
}

database "Banco de dados relacional\n(definição na Sprint 02)" as Database
cloud "Servidor SMTP" as SMTP

Usuario -down-> Browser
Browser -down-> AuthModule : acesso protegido
Browser -down-> MvcControllers : HTTP
AuthModule -right-> MvcControllers : identidade
MvcControllers -left-> ViewTemplates : dados da página
ViewTemplates -up-> Browser : HTML
MvcControllers -down-> AppService : comandos e consultas

AppService -down-> DomainModel : regras do domínio
AppService -right-> RepoPorts : consulta e registra
AuthModule -down-> RepoPorts : credenciais

Scheduler -up-> AppService : crédito semestral
Persistence -up..> RepoPorts : implementa
AppService -down-> MailAdapter : notificações

Persistence -down-> Database : ORM / SQL
MailAdapter -down-> SMTP : e-mail
Database -[hidden]right- SMTP
@enduml
