 parent="1"><mxGeometry x="614" y="966" width="18" height="18" as="geometry" /></mxCell><mxCell id="auto" value="Processo independente da sessão: DS06 descreve o crédito semestral disparado pelo agendador Spring. Ele não é iniciado pelo usuário e não participa deste fluxo de navegação." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=note;fillColor=#FFF1D8;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="62" y="850" width="340" height="152" as="geometry" /></mxCell><mxCell id="note" value="IG03, IG04 e IG05 detalham a seleção de uma interação por perfil. A troca de senha pendente deve concluir com sucesso antes do menu. DS12 e DS13 são previstos e não são chamados nesta versão. A decisão Continuar pressupõe sessão e usuário ativos; após desativação, encerrar o acesso." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=note;fillColor=#FFF1D8;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="842" y="780" width="340" height="232" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="start" target="login"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="login" target="auth"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" value="[inválido]" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="auth" target="login"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="427" y="285" /><mxPoint x="427" y="208" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="[válido]" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Ari