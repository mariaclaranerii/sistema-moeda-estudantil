<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="IG02" name="IG02"><mxGraphModel dx="1240" dy="1180" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="1180"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;ellipse;fillColor=#203449;" vertex="1" parent="1"><mxGeometry x="611" y="145" width="18" height="18" as="geometry" /></mxCell><mxCell id="event" value="Evento" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1"><mxGeometry x="584" y="205" width="72" height="44" as="geometry" /></mxCell><mxCell id="transfer" value="ref&lt;br&gt;&lt;b&gt;DS07 · Transferir moedas&lt;br&gt;transação confirmada&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=umlFrame;" vertex="1" parent="1"><mxGeometry x="102" y="324" width="340" height="70" as="geometry" /></mxCell><mxCell id="notify" value="ref&lt;br&gt;&lt;b&gt;DS12 · Avisar aluno por e-mail&lt;br&gt;PREVISTO - RF06&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=umlFrame;" vertex="1" parent="1"><mxGeometry x="102" y="474" width="340" height="70" as="geometry" /></mxCell><mxCell id="redeem" value="ref&lt;br&gt;&lt;b&gt;DS11 · Resgatar vantagem&lt;br&gt;código persistido&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=umlFrame;" vertex="1" parent="1"><mxGeometry x="802" y="324" width="340" height="70" as="geometry" /></mxCell><mxCell id="coupon" value="ref&lt;br&gt;&lt;b&gt;DS13 · Cupom ao aluno e empresa&lt;br&gt;PREVISTO - RF14, RF15&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=umlFrame;" vertex="1" parent="1"><mxGeometry x="802" y="474" width="340" height="70" as="geometry" /></mxCell><mxCell id="merge" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1"><mxGeometry x="604" y="620" width="32" height="32" as="geometry" /></mxCell><mxCell id="finish" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=doubleEllipse;fillColor=#203449;" vertex="1" parent="1"><mxGeometry x="611" y="702" width="18" height="18" as="geometry" /></mxCell><mxCell id="note" value="VISÃO DE COMPLEMENTAÇÃO, NÃO IMPLEMENTADA. A decisão escolhe uma das duas interações conforme o evento; não impõe execução concorrente. DS12 e DS13 deverão ser integrados após confirmação da transação. As mensagens dos dois destinatários usam o mesmo código de DS11. Falha de e-mail não deve gerar novo débito, transferência ou código. A política de repetição e o adaptador de envio ainda são decisões de implementação. O autocadastro de aluno e empresa descrito no enunciado continua divergente do acesso restrito ao professor; resolver essa regra antes de alterar DS02 e DS04." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;strokeColor=#203449;fillColor=#FFFFFF;shape=note;fillColor=#FFF1D8;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="790" width="1040" height="220" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="start" target="event"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge1" value="[transferência]" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="event" target="transfer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="272" y="227" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="[confirmada]" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="transfer" target="notify"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="[resgate]" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="event" target="redeem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="972" y="227" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="[confirmado]" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="redeem" target="coupon"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="notify" target="merge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="272" y="596" /><mxPoint x="620" y="596" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="coupon" target="merge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="972" y="596" /><mxPoint x="620" y="596" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=none;endArrow=open;endFill=0;html=1;fontFamily=Arial;fontSize=11;" edge="1" parent="1" source="merge" target="finish"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>